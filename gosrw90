#!/bin/bash
set -e
python -m scenario.srw_hangzhou1_90d.dump_scenario
python3 main.py scenario.srw_hangzhou1_90d 2>&1 | tee /tmp/.run_output90.txt
run_dir=$(grep 'Unified output written to:' /tmp/.run_output90.txt | sed 's/^.*: //')
if [ -n "$run_dir" ]; then
  python3 -m src.seta "$run_dir"
  python3 -m src.report "$run_dir"
  python3 -m src.sseta "$run_dir"
  python3 jsonl_count.py "$run_dir/sim.jsonl"
fi
rm -f /tmp/.run_output90.txt
